// OmaPhoenix desktop on Slint: the same two screens as the Tauri spike.
// Colours come only from the Theme global, filled from the live Omarchy
// theme by Rust (DESIGN.md §5.1). Motion values (ring, timeline offset,
// sheet position) are driven by Rust springs (DESIGN.md §6), because Slint's
// own `animate` keeps position but not velocity when interrupted.

export global Theme {
    in-out property <color> surface-base: #1e1e2e;
    in-out property <color> surface-sunken: #181825;
    in-out property <color> surface-deep: #11111b;
    in-out property <color> surface-raised: #313244;
    in-out property <color> text-primary: #cdd6f4;
    in-out property <color> text-secondary: #bac2de;
    in-out property <color> text-muted: #7f849c;
    in-out property <color> accent: #f38d70;
    in-out property <color> selection: #45475a;
    in-out property <color> state-risk: #f38ba8;
    in-out property <color> state-attention: #f9e2af;
    in-out property <color> state-fine: #a6e3a1;
    in-out property <color> state-info: #89dceb;
    in-out property <string> font: "monospace";
}

export struct Snap { id: string, when: string, note: string }
export struct PreviewRow { category: string, count: int, detail: string }

component KeyHint inherits Rectangle {
    in property <string> key;
    width: hint.preferred-width + 10px;
    height: 18px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.text-muted.with-alpha(0.4);
    accessible-role: none;
    hint := Text { text: key; font-size: 12px; color: Theme.text-muted; }
}

component Button inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked();
    min-height: 32px;
    border-radius: 6px;
    background: primary ? Theme.accent : (active ? Theme.selection : (touch.has-hover ? Theme.surface-raised : transparent));
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if (enabled && (e.text == Key.Return || e.text == " ")) { root.clicked(); return accept; }
            reject
        }
    }
    // Focus ring (DESIGN.md §7.1): visible, accent, 2 px.
    Rectangle {
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.accent;
        border-radius: 8px;
        x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px;
    }
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 10px; alignment: start;
        if key != "" : KeyHint { key: root.key; y: (parent.height - self.height) / 2; }
        Text {
            text: label;
            vertical-alignment: center;
            color: primary ? Theme.surface-deep : Theme.text-primary;
            font-weight: primary ? 600 : 400;
            accessible-role: none;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}

component ScoreRing inherits Rectangle {
    in property <float> value; // animated
    in property <int> score;
    width: 132px;
    height: 132px;
    property <float> p: Math.max(0.0001, Math.min(0.9999, value / 100));
    property <color> tone: value >= 80 ? Theme.state-fine : (value >= 60 ? Theme.state-attention : Theme.state-risk);
    property <string> grade: score >= 90 ? "A" : (score >= 80 ? "B" : (score >= 70 ? "C" : (score >= 60 ? "D" : "F")));
    accessible-role: progress-indicator;
    accessible-label: "Audit score";
    accessible-value: score;
    accessible-description: "grade " + grade;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 120; viewbox-height: 120;
        fill: transparent; stroke: Theme.surface-sunken; stroke-width: 9px;
        MoveTo { x: 60; y: 8; }
        ArcTo { x: 60; y: 112; radius-x: 52; radius-y: 52; sweep: true; }
        ArcTo { x: 60; y: 8; radius-x: 52; radius-y: 52; sweep: true; }
    }
    Path {
        width: 100%; height: 100%;
        viewbox-width: 120; viewbox-height: 120;
        fill: transparent; stroke: tone; stroke-width: 9px;
        MoveTo { x: 60; y: 8; }
        ArcTo {
            x: 60 + 52 * Math.sin(p * 360deg);
            y: 60 - 52 * Math.cos(p * 360deg);
            radius-x: 52; radius-y: 52; large-arc: p > 0.5; sweep: true;
        }
    }
    VerticalLayout {
        alignment: center;
        Text { text: Math.round(value); font-size: 40px; font-weight: 600; horizontal-alignment: center; color: Theme.text-primary; accessible-role: none; }
        Text { text: grade; horizontal-alignment: center; color: Theme.text-secondary; accessible-role: none; }
    }
}

component Fact inherits HorizontalLayout {
    in property <color> marker;
    in property <string> label;
    spacing: 8px;
    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: marker; y: (parent.height - 8px) / 2; }
    Text { text: label; color: Theme.text-primary; }
}

component Card inherits Rectangle {
    background: Theme.surface-raised;
    border-radius: 10px;
}

export component App inherits Window {
    title: "OmaPhoenix";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.surface-base;
    default-font-family: Theme.font;
    default-font-size: 13px;

    in-out property <int> section: 0;
    in property <float> ring-value: 0;
    in property <int> score: 72;
    in property <[Snap]> snaps;
    in property <length> drop: 0px;
    in property <length> sheet-y: 460px;
    in property <bool> sheet-visible: false;
    in property <[PreviewRow]> rows;
    in property <bool> rows-loaded: false;
    in property <bool> rows-revealed: false;
    callback take-snapshot();
    callback open-preview();
    callback close-preview();
    callback go(int);
    callback drag-sheet(length);
    callback release-sheet();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (root.sheet-visible) {
                if (e.text == Key.Escape) { root.close-preview(); return accept; }
                return reject;
            }
            if (e.text == "1") { root.go(0); return accept; }
            if (e.text == "2") { root.go(1); return accept; }
            if (e.text == "s" && root.section == 0) { root.take-snapshot(); return accept; }
            reject
        }

        HorizontalLayout {
            Rectangle {
                width: 200px;
                background: Theme.surface-sunken;
                VerticalLayout {
                    padding: 12px; padding-top: 16px; spacing: 4px; alignment: start;
                    HorizontalLayout {
                        padding-left: 8px; padding-bottom: 12px; spacing: 8px;
                        Rectangle { width: 10px; height: 14px; border-radius: 5px; background: Theme.accent; y: 2px; }
                        Text { text: "OmaPhoenix"; font-size: 15px; font-weight: 600; color: Theme.text-primary; }
                    }
                    Button { label: "Pulse"; key: "1"; active: root.section == 0; clicked => { root.go(0); } }
                    Button { label: "Migrate"; key: "2"; active: root.section == 1; clicked => { root.go(1); } }
                }
            }

            // Kept alive and toggled: creating/destroying subtrees on every
            // switch caused frame hitches in the bench.
            pulse := VerticalLayout {
                visible: root.section == 0;
                width: root.section == 0 ? self.preferred-width : 0px;
                padding: 32px; spacing: 24px; alignment: start;
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "You're protected."; font-size: 20px; font-weight: 600; color: Theme.text-primary; accessible-role: text; }
                    Text { text: "Last snapshot 2h ago. Automatic snapshots every 30 min."; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    spacing: 24px;
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            Text { text: "Health"; font-size: 15px; font-weight: 600; color: Theme.text-primary; }
                            HorizontalLayout {
                                spacing: 24px; alignment: start;
                                ScoreRing { value: root.ring-value; score: root.score; }
                                VerticalLayout {
                                    spacing: 8px; alignment: center;
                                    Fact { marker: Theme.state-attention; label: "2 worth a look"; }
                                    Fact { marker: Theme.state-fine; label: "38 fine"; }
                                    Fact { marker: Theme.state-info; label: "4 notes"; }
                                }
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            Text { text: "Timeline"; font-size: 15px; font-weight: 600; color: Theme.text-primary; }
                            Rectangle {
                                height: 220px;
                                clip: true;
                                Rectangle { x: 11px; width: 2px; background: Theme.surface-sunken; }
                                Rectangle {
                                    y: root.drop;
                                    height: root.snaps.length * 44px;
                                    VerticalLayout {
                                        for s[i] in root.snaps : HorizontalLayout {
                                            height: 44px; spacing: 12px;
                                            opacity: i == 0 ? Math.max(0, 1 + root.drop / 44px) : 1;
                                            Rectangle {
                                                width: 24px;
                                                Rectangle { x: 7px; y: (parent.height - 10px) / 2; width: 10px; height: 10px; border-radius: 5px; background: i == 0 ? Theme.accent : Theme.text-muted; }
                                            }
                                            Text { text: s.when; width: 128px; vertical-alignment: center; color: Theme.text-primary; }
                                            Text { text: s.note; vertical-alignment: center; color: Theme.text-secondary; }
                                        }
                                    }
                                }
                            }
                            Button { label: "Take snapshot"; key: "s"; primary: true; clicked => { root.take-snapshot(); } }
                        }
                    }
                }
            }

            VerticalLayout {
                visible: root.section == 1;
                width: root.section == 1 ? self.preferred-width : 0px;
                padding: 32px; spacing: 24px; alignment: start;
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Migrate"; font-size: 20px; font-weight: 600; color: Theme.text-primary; }
                    Text { text: "Step 3 of 5 · Preview what this machine will get."; color: Theme.text-secondary; }
                }
                Card {
                    VerticalLayout {
                        padding: 16px; spacing: 12px; alignment: start;
                        Text { text: "Snapshot c4ed652 from a Dell Inc. Latitude 7430, taken 2h ago."; color: Theme.text-primary; }
                        HorizontalLayout { alignment: start; Button { label: "Preview changes"; primary: true; clicked => { root.open-preview(); } } }
                    }
                }
            }
        }

        Rectangle {
            visible: root.sheet-visible;
            Rectangle {
                background: Theme.surface-deep;
                opacity: Math.max(0, 1 - root.sheet-y / 460px) * 0.5;
                TouchArea { clicked => { root.close-preview(); } }
            }
            Rectangle {
                width: Math.min(720px, parent.width);
                height: 460px;
                x: (parent.width - self.width) / 2;
                y: parent.height - 460px + root.sheet-y;
                background: Theme.surface-raised;
                border-top-left-radius: 14px;
                border-top-right-radius: 14px;
                VerticalLayout {
                    padding: 24px; padding-top: 8px; spacing: 8px;
                    Rectangle {
                        height: 18px;
                        Rectangle { width: 48px; height: 4px; border-radius: 2px; background: Theme.text-muted; }
                        grip := TouchArea {
                            moved => { root.drag-sheet(self.mouse-y - self.pressed-y); }
                            pointer-event(e) => { if (e.kind == PointerEventKind.up) { root.release-sheet(); } }
                        }
                    }
                    Text { text: "Here's what restoring would change"; font-size: 15px; font-weight: 600; color: Theme.text-primary; }
                    Text { text: "Nothing changes until you apply. Files that get replaced are kept as .pre-restore."; font-size: 12px; color: Theme.text-muted; }
                    if !root.rows-loaded : Text { text: "Working out the changes…"; color: Theme.text-muted; }
                    for r[i] in root.rows : HorizontalLayout {
                        spacing: 12px; height: 32px;
                        opacity: root.rows-revealed ? 1 : 0;
                        animate opacity { delay: Math.min(i, 8) * 18ms; duration: 260ms; easing: ease-out; }
                        Text { text: r.category; width: 120px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                        Text { text: r.count; width: 56px; horizontal-alignment: right; color: Theme.text-primary; vertical-alignment: center; }
                        Text { text: r.detail; color: Theme.text-secondary; vertical-alignment: center; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        alignment: end; spacing: 8px;
                        Button { label: "Back"; clicked => { root.close-preview(); } }
                        Button { label: "Apply changes"; primary: true; enabled: root.rows-loaded; }
                    }
                }
            }
        }
    }
}
