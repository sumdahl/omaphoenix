// OmaPhoenix desktop (Slint): DESIGN.md §4's six sections on keys 1-6.
// Colours come only from the Theme global, filled from the live Omarchy
// theme by Rust (§5.1). Motion values are driven by Rust springs (§6).
// Components below the structs are reused from the measured spike
// (spikes/slint-desktop): accessible buttons, the score ring.

import { ListView, AboutSlint } from "std-widgets.slint";

export global Theme {
    in-out property <color> surface-base: #1e1e2e;
    in-out property <color> surface-sunken: #181825;
    in-out property <color> surface-deep: #11111b;
    in-out property <color> surface-raised: #313244;
    in-out property <color> text-primary: #cdd6f4;
    in-out property <color> text-secondary: #bac2de;
    in-out property <color> text-muted: #7f849c;
    in-out property <color> accent: #f38d70;
    in-out property <color> selection: #45475a;
    in-out property <color> state-risk: #f38ba8;
    in-out property <color> state-attention: #f9e2af;
    in-out property <color> state-fine: #a6e3a1;
    in-out property <color> state-info: #89dceb;
    in-out property <string> font: "monospace";
}

export struct Snap { id: string, when: string, note: string }
export struct PreviewRow { category: string, count: int, detail: string }
export struct AuditRow { sev: string, title: string, section: string, detail: string, fix: string, hint: string, accepted: bool }
export struct CatRow { name: string, selected: int, total: int, note: string }
export struct ItemRow { id: string, on: bool, note: string }
export struct StepRow { title: string, done: bool, explain: string }

component KeyHint inherits Rectangle {
    in property <string> key;
    width: hint.preferred-width + 10px;
    height: 18px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.text-muted.with-alpha(0.4);
    accessible-role: none;
    // The key is decoration for sighted users; screen readers get the button's name.
    hint := Text { text: key; font-size: 12px; color: Theme.text-muted; accessible-role: none; }
}

component Button inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked();
    min-height: 32px;
    border-radius: 6px;
    background: primary ? Theme.accent : (active ? Theme.selection : (touch.has-hover ? Theme.surface-raised : transparent));
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if (enabled && (e.text == Key.Return || e.text == " ")) { root.clicked(); return accept; }
            reject
        }
    }
    // Focus ring (DESIGN.md §7.1): visible, accent, 2 px.
    Rectangle {
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.accent;
        border-radius: 8px;
        x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px;
    }
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 10px; alignment: start;
        if key != "" : KeyHint { key: root.key; y: (parent.height - self.height) / 2; }
        Text {
            text: label;
            vertical-alignment: center;
            color: primary ? Theme.surface-deep : Theme.text-primary;
            font-weight: primary ? 600 : 400;
            accessible-role: none;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}

component ScoreRing inherits Rectangle {
    in property <float> value; // animated
    in property <int> score;
    width: 132px;
    height: 132px;
    property <float> p: Math.max(0.0001, Math.min(0.9999, value / 100));
    property <color> tone: value >= 80 ? Theme.state-fine : (value >= 60 ? Theme.state-attention : Theme.state-risk);
    property <string> grade: score >= 90 ? "A" : (score >= 80 ? "B" : (score >= 70 ? "C" : (score >= 60 ? "D" : "F")));
    accessible-role: progress-indicator;
    accessible-label: "Audit score";
    accessible-value: score;
    accessible-description: "grade " + grade;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 120; viewbox-height: 120;
        fill: transparent; stroke: Theme.surface-sunken; stroke-width: 9px;
        MoveTo { x: 60; y: 8; }
        ArcTo { x: 60; y: 112; radius-x: 52; radius-y: 52; sweep: true; }
        ArcTo { x: 60; y: 8; radius-x: 52; radius-y: 52; sweep: true; }
    }
    Path {
        width: 100%; height: 100%;
        viewbox-width: 120; viewbox-height: 120;
        fill: transparent; stroke: tone; stroke-width: 9px;
        MoveTo { x: 60; y: 8; }
        ArcTo {
            x: 60 + 52 * Math.sin(p * 360deg);
            y: 60 - 52 * Math.cos(p * 360deg);
            radius-x: 52; radius-y: 52; large-arc: p > 0.5; sweep: true;
        }
    }
    VerticalLayout {
        alignment: center;
        Text { text: Math.round(value); font-size: 40px; font-weight: 600; horizontal-alignment: center; color: Theme.text-primary; accessible-role: none; }
        Text { text: grade; horizontal-alignment: center; color: Theme.text-secondary; accessible-role: none; }
    }
}

component Fact inherits HorizontalLayout {
    in property <color> marker;
    in property <string> label;
    spacing: 8px;
    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: marker; y: (parent.height - 8px) / 2; }
    Text { text: label; color: Theme.text-primary; }
}

component Card inherits Rectangle {
    background: Theme.surface-raised;
    border-radius: 10px;
}


component Heading inherits Text {
    font-size: 20px;
    font-weight: 600;
    color: Theme.text-primary;
    accessible-role: text;
}

component Muted inherits Text {
    color: Theme.text-secondary;
    wrap: word-wrap;
}

component SevTag inherits Rectangle {
    in property <string> sev;
    in property <bool> accepted;
    width: 78px;
    height: 20px;
    border-radius: 4px;
    background: accepted ? Theme.surface-sunken : (sev == "fail" ? Theme.state-risk.with-alpha(0.2) : Theme.state-attention.with-alpha(0.2));
    Text {
        text: accepted ? "ACCEPTED" : (sev == "fail" ? "FAIL" : "WARN");
        font-size: 11px;
        font-weight: 600;
        color: accepted ? Theme.text-muted : (sev == "fail" ? Theme.state-risk : Theme.state-attention);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component App inherits Window {
    title: "OmaPhoenix";
    icon: @image-url("../../../share/icons/omaphoenix.svg");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.surface-base;
    default-font-family: Theme.font;
    default-font-size: 13px;

    in-out property <int> section: 0;
    in property <string> toast;
    in property <string> busy;

    // Pulse
    in property <string> headline;
    in property <string> subline;
    in property <string> last-snapshot;
    in property <bool> timer-on;
    in property <bool> set-up;
    in property <float> ring-value;
    in property <int> score;
    in property <bool> audited;
    in property <int> fails;
    in property <int> warns;
    in property <int> accepted;
    in property <int> doctor-risks: -1;
    in property <string> primary-label;

    // Timeline
    in property <[Snap]> snaps;
    in property <length> drop: 0px;
    in property <length> sheet-y: 460px;
    in property <bool> sheet-visible;
    in property <[PreviewRow]> rows;
    in property <bool> rows-loaded;
    in property <string> preview-id;

    // Audit
    in property <[AuditRow]> findings;
    in-out property <int> finding-sel: 0;

    // Backup
    in property <[CatRow]> cats;
    in-out property <int> cat-sel: -1;
    in property <[ItemRow]> items;
    in property <bool> backup-dirty;

    // Migrate
    in property <[StepRow]> steps;

    // Settings
    in property <string> timer-status;
    in property <string> repo-dir;
    in property <string> remote;
    in property <bool> secrets-ready;

    callback go(int);
    callback primary();
    callback take-snapshot();
    callback open-preview(string);
    callback close-preview();
    callback apply-restore();
    callback drag-sheet(length);
    callback release-sheet();
    callback scan();
    callback toggle-accept(int);
    callback run-fix(int);
    callback select-cat(int);
    callback toggle-cat(int);
    callback toggle-item(int);
    callback save-backup();
    callback migrate-step(int);
    callback toggle-timer();
    callback setup-secrets();
    callback set-up-repo();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (root.sheet-visible) {
                if (e.text == Key.Escape) { root.close-preview(); return accept; }
                return reject;
            }
            if (e.text == "1") { root.go(0); return accept; }
            if (e.text == "2") { root.go(1); return accept; }
            if (e.text == "3") { root.go(2); return accept; }
            if (e.text == "4") { root.go(3); return accept; }
            if (e.text == "5") { root.go(4); return accept; }
            if (e.text == "6") { root.go(5); return accept; }
            if (e.text == "s" && (root.section == 0 || root.section == 1)) { root.take-snapshot(); return accept; }
            if (e.text == "s" && root.section == 2) { root.scan(); return accept; }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;
                // Sidebar (DESIGN.md §4)
                Rectangle {
                    width: 210px;
                    background: Theme.surface-sunken;
                    VerticalLayout {
                        padding: 12px; padding-top: 16px; spacing: 4px; alignment: start;
                        HorizontalLayout {
                            padding-left: 8px; padding-bottom: 12px; spacing: 8px;
                            Rectangle { width: 10px; height: 14px; border-radius: 5px; background: Theme.accent; y: 2px; }
                            Text { text: "OmaPhoenix"; font-size: 15px; font-weight: 600; color: Theme.text-primary; }
                        }
                        Button { label: "Pulse"; key: "1"; active: root.section == 0; clicked => { root.go(0); } }
                        Button { label: "Timeline"; key: "2"; active: root.section == 1; clicked => { root.go(1); } }
                        Button { label: "Audit"; key: "3"; active: root.section == 2; clicked => { root.go(2); } }
                        Button { label: "Backup"; key: "4"; active: root.section == 3; clicked => { root.go(3); } }
                        Button { label: "Migrate"; key: "5"; active: root.section == 4; clicked => { root.go(4); } }
                        Button { label: "Settings"; key: "6"; active: root.section == 5; clicked => { root.go(5); } }
                    }
                }

                // 1 Pulse
                VerticalLayout {
                    visible: root.section == 0;
                    width: root.section == 0 ? self.preferred-width : 0px;
                    padding: 32px; spacing: 24px; alignment: start;
                    VerticalLayout {
                        spacing: 6px;
                        Heading { text: root.headline; }
                        Muted { text: root.subline; }
                    }
                    HorizontalLayout {
                        spacing: 24px; alignment: start;
                        Card {
                            VerticalLayout {
                                padding: 16px; spacing: 12px;
                                Text { text: "Protection"; font-size: 15px; font-weight: 600; color: Theme.text-primary; }
                                Fact { marker: root.set-up ? Theme.state-fine : Theme.state-risk; label: root.last-snapshot; }
                                Fact { marker: root.timer-on ? Theme.state-fine : Theme.state-attention; label: root.timer-on ? "Automatic snapshots on" : "Automatic snapshots off"; }
                                Fact {
                                    marker: root.doctor-risks == 0 ? Theme.state-fine : (root.doctor-risks < 0 ? Theme.text-muted : Theme.state-risk);
                                    label: root.doctor-risks < 0 ? "Checking what a reinstall would lose…" : (root.doctor-risks == 0 ? "Nothing would be lost in a reinstall" : root.doctor-risks + " thing(s) would be lost in a reinstall");
                                }
                            }
                        }
                        Card {
                            VerticalLayout {
                                padding: 16px; spacing: 12px;
                                Text { text: "Health"; font-size: 15px; font-weight: 600; color: Theme.text-primary; }
                                if root.audited : HorizontalLayout {
                                    spacing: 24px; alignment: start;
                                    ScoreRing { value: root.ring-value; score: root.score; }
                                    VerticalLayout {
                                        spacing: 8px; alignment: center;
                                        Fact { marker: Theme.state-risk; label: root.fails + " fail"; }
                                        Fact { marker: Theme.state-attention; label: root.warns + " worth a look"; }
                                        Fact { marker: Theme.text-muted; label: root.accepted + " accepted"; }
                                    }
                                }
                                if !root.audited : Muted { text: "No audit yet. Snapshots audit themselves; run one to see the whole picture."; }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button { label: root.primary-label; key: "enter"; primary: true; clicked => { root.primary(); } }
                    }
                }

                // 2 Timeline
                VerticalLayout {
                    visible: root.section == 1;
                    width: root.section == 1 ? self.preferred-width : 0px;
                    padding: 32px; spacing: 16px;
                    HorizontalLayout {
                        Heading { text: "Timeline"; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { label: "Take snapshot"; key: "s"; primary: true; enabled: root.set-up; clicked => { root.take-snapshot(); } }
                    }
                    if root.snaps.length == 0 : Muted { text: root.set-up ? "No snapshots yet. Take the first one." : "Not set up yet: Settings → Set up snapshots."; }
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        Rectangle { x: 11px; width: 2px; background: Theme.surface-sunken; }
                        Rectangle {
                            y: root.drop;
                            ListView {
                                for s[i] in root.snaps : HorizontalLayout {
                                    height: 44px; spacing: 12px;
                                    opacity: i == 0 ? Math.max(0, 1 + root.drop / 44px) : 1;
                                    accessible-role: list-item;
                                    accessible-label: "Snapshot " + s.id + ", " + s.when;
                                    Rectangle {
                                        width: 24px;
                                        Rectangle { x: 7px; y: (parent.height - 10px) / 2; width: 10px; height: 10px; border-radius: 5px; background: i == 0 ? Theme.accent : Theme.text-muted; }
                                    }
                                    Text { text: s.when; width: 150px; vertical-alignment: center; color: Theme.text-primary; }
                                    Text { text: s.id; width: 80px; vertical-alignment: center; color: Theme.text-secondary; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { label: "Preview restore"; clicked => { root.open-preview(s.id); } }
                                }
                            }
                        }
                    }
                }

                // 3 Audit
                VerticalLayout {
                    visible: root.section == 2;
                    width: root.section == 2 ? self.preferred-width : 0px;
                    padding: 32px; spacing: 16px;
                    HorizontalLayout {
                        spacing: 16px;
                        Heading { text: "Audit"; }
                        if root.audited : Muted { text: "Score " + root.score + " · " + root.fails + " fail · " + root.warns + " warn · " + root.accepted + " accepted"; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { label: "Scan now"; key: "s"; primary: true; clicked => { root.scan(); } }
                    }
                    if !root.audited : Muted { text: "A quick audit runs as you, without sudo, and never changes anything."; }
                    if root.audited && root.findings.length == 0 : Muted { text: "No risks. Nice."; }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 16px;
                        ListView {
                            width: 50%;
                            for f[i] in root.findings : Rectangle {
                                height: 36px;
                                background: i == root.finding-sel ? Theme.selection : transparent;
                                border-radius: 6px;
                                accessible-role: list-item;
                                accessible-label: (f.accepted ? "accepted: " : f.sev + ": ") + f.title;
                                HorizontalLayout {
                                    padding-left: 8px; spacing: 10px;
                                    SevTag { sev: f.sev; accepted: f.accepted; y: (parent.height - self.height) / 2; }
                                    Text { text: f.title; vertical-alignment: center; color: Theme.text-primary; overflow: elide; }
                                }
                                TouchArea { clicked => { root.finding-sel = i; } }
                            }
                        }
                        if root.findings.length > 0 : Card {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 16px; spacing: 10px; alignment: start;
                                Muted { text: root.findings[root.finding-sel].section; }
                                Text { text: root.findings[root.finding-sel].title; font-size: 15px; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
                                if root.findings[root.finding-sel].detail != "" : Text { text: root.findings[root.finding-sel].detail; color: Theme.text-secondary; wrap: word-wrap; }
                                if root.findings[root.finding-sel].fix != "" : Text { text: "$ " + root.findings[root.finding-sel].fix; color: Theme.accent; wrap: word-wrap; }
                                if root.findings[root.finding-sel].hint != "" : Muted { text: root.findings[root.finding-sel].hint; }
                                HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Button { label: root.findings[root.finding-sel].accepted ? "Move back to risks" : "Accept risk"; clicked => { root.toggle-accept(root.finding-sel); } }
                                    if root.findings[root.finding-sel].fix != "" : Button { label: "Run fix in a terminal"; clicked => { root.run-fix(root.finding-sel); } }
                                }
                            }
                        }
                    }
                }

                // 4 Backup
                VerticalLayout {
                    visible: root.section == 3;
                    width: root.section == 3 ? self.preferred-width : 0px;
                    padding: 32px; spacing: 16px;
                    HorizontalLayout {
                        Heading { text: "Backup"; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { label: "Save"; primary: true; enabled: root.backup-dirty; clicked => { root.save-backup(); } }
                    }
                    Muted { text: "What snapshots capture. New items in a ticked category are included automatically."; }
                    if root.cats.length == 0 : Muted { text: "Detecting what is on this machine…"; }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 16px;
                        ListView {
                            width: 300px;
                            for c[i] in root.cats : Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: i == root.cat-sel ? Theme.selection : transparent;
                                accessible-role: checkbox;
                                accessible-checked: c.selected == c.total && c.total > 0;
                                accessible-label: c.name + ", " + c.selected + " of " + c.total + " captured";
                                HorizontalLayout {
                                    padding-left: 8px; spacing: 10px;
                                    Text {
                                        text: c.selected == c.total && c.total > 0 ? "[x]" : (c.selected > 0 ? "[-]" : "[ ]");
                                        vertical-alignment: center; color: Theme.accent;
                                        TouchArea { clicked => { root.toggle-cat(i); } }
                                    }
                                    Text { text: c.name; width: 90px; vertical-alignment: center; color: Theme.text-primary; }
                                    Text { text: c.selected + " of " + c.total; vertical-alignment: center; color: Theme.text-secondary; }
                                }
                                TouchArea { x: 40px; clicked => { root.select-cat(i); } }
                            }
                        }
                        ListView {
                            horizontal-stretch: 1;
                            for it[i] in root.items : HorizontalLayout {
                                height: 28px; spacing: 10px;
                                accessible-role: checkbox;
                                accessible-checked: it.on;
                                accessible-label: it.id;
                                Text { text: it.on ? "[x]" : "[ ]"; vertical-alignment: center; color: Theme.accent; }
                                Text { text: it.id; vertical-alignment: center; color: Theme.text-primary; overflow: elide; }
                                Text { text: it.note; vertical-alignment: center; color: Theme.text-muted; }
                                TouchArea { clicked => { root.toggle-item(i); } }
                            }
                        }
                    }
                }

                // 5 Migrate
                VerticalLayout {
                    visible: root.section == 4;
                    width: root.section == 4 ? self.preferred-width : 0px;
                    padding: 32px; spacing: 16px; alignment: start;
                    Heading { text: "Migrate to a new machine"; }
                    Muted { text: "Audit → clean → snapshot → restore → re-audit. Quit any time; progress is kept."; }
                    for st[i] in root.steps : Card {
                        HorizontalLayout {
                            padding: 14px; spacing: 14px;
                            Text { text: st.done ? "✓" : (i + 1); width: 20px; font-weight: 600; color: st.done ? Theme.state-fine : Theme.text-muted; vertical-alignment: center; }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: st.title; font-weight: 600; color: Theme.text-primary; }
                                Muted { text: st.explain; }
                            }
                            Button { label: st.done ? "Again" : "Do it"; y: (parent.height - self.height) / 2; clicked => { root.migrate-step(i); } }
                        }
                    }
                }

                // 6 Settings
                VerticalLayout {
                    visible: root.section == 5;
                    width: root.section == 5 ? self.preferred-width : 0px;
                    padding: 32px; spacing: 16px; alignment: start;
                    Heading { text: "Settings"; }
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 8px;
                            Text { text: "Schedule"; font-weight: 600; color: Theme.text-primary; }
                            Muted { text: root.timer-status; }
                            HorizontalLayout { alignment: start; Button { label: root.timer-on ? "Turn automatic snapshots off" : "Snapshot every 30 minutes"; clicked => { root.toggle-timer(); } } }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 8px;
                            Text { text: "Snapshot repo"; font-weight: 600; color: Theme.text-primary; }
                            Muted { text: root.repo-dir; }
                            Muted { text: root.remote == "" ? "No remote: snapshots die with this disk." : "Remote: " + root.remote; }
                            if !root.set-up : HorizontalLayout { alignment: start; Button { label: "Set up snapshots"; primary: true; clicked => { root.set-up-repo(); } } }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 8px;
                            Text { text: "Secrets"; font-weight: 600; color: Theme.text-primary; }
                            Muted { text: root.secrets-ready ? "SSH keys travel encrypted." : "SSH keys are not in snapshots."; }
                            if !root.secrets-ready : HorizontalLayout { alignment: start; Button { label: "Set up encrypted secrets"; clicked => { root.setup-secrets(); } } }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 8px;
                            Text { text: "Audit before backup"; font-weight: 600; color: Theme.text-primary; }
                            Muted { text: "Risky files the audit finds are left out of snapshots (failures), or captured and noted (warnings)."; }
                        }
                    }
                    // Slint Royalty-free license attribution (docs/07, Q10).
                    AboutSlint { }
                }
            }

            // Status line: toast or what's running, in words, never colour alone.
            Rectangle {
                height: 28px;
                background: Theme.surface-sunken;
                Text {
                    x: 16px;
                    text: root.toast != "" ? root.toast : root.busy;
                    color: root.toast != "" ? Theme.accent : Theme.text-muted;
                    vertical-alignment: center;
                    accessible-role: text;
                }
            }
        }

        // Restore preview sheet
        Rectangle {
            visible: root.sheet-visible;
            Rectangle {
                background: Theme.surface-deep;
                opacity: Math.max(0, 1 - root.sheet-y / 460px) * 0.5;
                TouchArea { clicked => { root.close-preview(); } }
            }
            Rectangle {
                width: Math.min(720px, parent.width);
                height: 460px;
                x: (parent.width - self.width) / 2;
                y: parent.height - 460px + root.sheet-y;
                background: Theme.surface-raised;
                border-top-left-radius: 14px;
                border-top-right-radius: 14px;
                VerticalLayout {
                    padding: 24px; padding-top: 8px; spacing: 8px;
                    Rectangle {
                        height: 18px;
                        Rectangle { width: 48px; height: 4px; border-radius: 2px; background: Theme.text-muted; }
                        TouchArea {
                            moved => { root.drag-sheet(self.mouse-y - self.pressed-y); }
                            pointer-event(e) => { if (e.kind == PointerEventKind.up) { root.release-sheet(); } }
                        }
                    }
                    Text { text: "Restoring " + root.preview-id + " would change"; font-size: 15px; font-weight: 600; color: Theme.text-primary; }
                    Text { text: "Nothing changes until you apply. Files that get replaced are kept as .pre-restore."; font-size: 12px; color: Theme.text-muted; }
                    if !root.rows-loaded : Text { text: "Working out the changes…"; color: Theme.text-muted; }
                    if root.rows-loaded && root.rows.length == 0 : Text { text: "Nothing: this machine already matches that snapshot."; color: Theme.state-fine; }
                    for r[i] in root.rows : HorizontalLayout {
                        spacing: 12px; height: 28px;
                        Text { text: r.category; width: 120px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                        Text { text: r.count; width: 56px; horizontal-alignment: right; color: Theme.text-primary; vertical-alignment: center; }
                        Text { text: r.detail; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        alignment: end; spacing: 8px;
                        Button { label: "Back"; clicked => { root.close-preview(); } }
                        Button { label: "Apply in a terminal"; primary: true; enabled: root.rows-loaded && root.rows.length > 0; clicked => { root.apply-restore(); } }
                    }
                }
            }
        }
    }
}
