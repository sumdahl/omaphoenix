{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmaPhoenix",
  "identifier": "io.github.sumdahl.omaphoenix",
  "build": {
    "frontendDist": "../../ui/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../ui/desktop run dev",
    "beforeBuildCommand": "npm --prefix ../../ui/desktop run build"
  },
  "app": {
    "windows": [
      { "title": "OmaPhoenix", "width": 1100, "height": 720, "minWidth": 720, "minHeight": 480, "decorations": false, "center": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"] }
}
