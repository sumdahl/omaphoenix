[Desktop Entry]
Type=Application
Name=Security Audit (Desktop)
GenericName=System Security Audit
Comment=Scan this machine, review findings and apply fixes, in a window
Exec=@BINDIR@/secaudit-gui
Icon=secaudit
StartupWMClass=secaudit-gui
Categories=System;Security;
Keywords=security;audit;secaudit;hardening;scan;
Terminal=false
