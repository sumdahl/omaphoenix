[Desktop Entry]
Type=Application
Name=OmaPhoenix Audit
GenericName=System Security Audit
Comment=Scan this machine, review findings and apply fixes
Exec=@LAUNCH@ @BINDIR@/omaphoenix audit tui
Icon=omaphoenix-audit
Categories=System;Security;
Keywords=security;audit;omaphoenix;secaudit;hardening;scan;
Terminal=@TERMINAL@
